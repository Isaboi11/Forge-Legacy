# Forge Legacy — env template (COMMITTED). Copy to .env (gitignored) and fill in.
# Both values come from the Supabase dashboard → Project Settings → API.
# The publishable/anon key is client-safe (RLS-scoped) and gets bundled into the app.
# NEVER put the service_role key here or in .env — it bypasses RLS; keep it server-side only.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
