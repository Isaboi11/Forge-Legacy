{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/AppBar/**",
              "components/Avatar/**",
              "components/Button/**",
              "components/CountBadge/**",
              "components/Inputs/**",
              "components/Insignia/**",
              "components/ListRow/**",
              "components/Overlays/**",
              "components/Pill/**",
              "components/Progress/**",
              "components/RankMarker/**",
              "components/SectionHeader/**",
              "components/StatBlock/**",
              "components/States/**",
              "components/Surface/**",
              "components/TabBar/**",
              "components/TimelineRow/**",
              "components/Toast/**",
              "image-slot.js"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Playfair Display))/i]",
        "message": "Font not provided by the design system. Available: Playfair Display."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onBack|onClose|avatar|onAvatar|actions|serif|transparent|style|key|ref|className|style|children)$/]",
        "message": "<AppBar> doesn't accept that prop. Declared props: title, onBack, onClose, avatar, onAvatar, actions, serif, transparent, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|ring|presence|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, ring, presence, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarGlyph'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|style|key|ref|className|style|children)$/]",
        "message": "<AvatarGlyph> doesn't accept that prop. Declared props: name, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|dismissible|title|showHandle|maxHeight|children|footer|style|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: open, onClose, dismissible, title, showHandle, maxHeight, children, footer, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|trailingIcon|fullWidth|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, icon, trailingIcon, fullWidth, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|destructive|text|icon)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'destructive' | 'text' | 'icon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|radius|padding|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, radius, padding, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|hero|elevated)$/]",
        "message": "<Card> variant must be one of 'default' | 'hero' | 'elevated'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Card> radius must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CountBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|max|dot|children|style|key|ref|className|style|children)$/]",
        "message": "<CountBadge> doesn't accept that prop. Declared props: count, max, dot, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|message|action|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, message, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InputField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|defaultValue|placeholder|helper|error|maxLength|showCount|type|leadingIcon|disabled|onChange|id|style|key|ref|className|style|children)$/]",
        "message": "<InputField> doesn't accept that prop. Declared props: label, value, defaultValue, placeholder, helper, error, maxLength, showCount, type, leadingIcon, disabled, onChange, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Insignia'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|artwork|placeholderLabel|label|sublabel|muted|glow|style|key|ref|className|style|children)$/]",
        "message": "<Insignia> doesn't accept that prop. Declared props: variant, size, artwork, placeholderLabel, label, sublabel, muted, glow, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Insignia'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:rank|honor)$/]",
        "message": "<Insignia> variant must be one of 'rank' | 'honor'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|subtitle|value|valueUnit|thumbnail|playable|density|trailing|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: icon, title, subtitle, value, valueUnit, thumbnail, playable, density, trailing, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute[name.name='density'] > Literal[value!=/^(?:compact|default|exercise)$/]",
        "message": "<ListRow> density must be one of 'compact' | 'default' | 'exercise'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|dismissible|eyebrow|title|artwork|children|footer|style|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, onClose, dismissible, eyebrow, title, artwork, children, footer, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: children, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:bronze|muted)$/]",
        "message": "<Pill> tone must be one of 'bronze' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Pill> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|height|label|trailing|showTrack|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, max, height, label, trailing, showTrack, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|size|stroke|children|style|key|ref|className|style|children)$/]",
        "message": "<ProgressRing> doesn't accept that prop. Declared props: value, max, size, stroke, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RankMarker'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|variant|size|style|key|ref|className|style|children)$/]",
        "message": "<RankMarker> doesn't accept that prop. Declared props: label, icon, variant, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RankMarker'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:rank|honor)$/]",
        "message": "<RankMarker> variant must be one of 'rank' | 'honor'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RankMarker'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<RankMarker> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|action|onAction|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: label, icon, action, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|count|style|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: variant, count, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:row|card|section)$/]",
        "message": "<Skeleton> variant must be one of 'row' | 'card' | 'section'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|value|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<StatBlock> doesn't accept that prop. Declared props: icon, value, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Surface'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|radius|bronzeEdge|glow|interactive|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Surface> doesn't accept that prop. Declared props: variant, radius, bronzeEdge, glow, interactive, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Surface'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:card|elevated|recessed|panel|modal)$/]",
        "message": "<Surface> variant must be one of 'card' | 'elevated' | 'recessed' | 'panel' | 'modal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Surface'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:xs|sm|md|lg|xl)$/]",
        "message": "<Surface> radius must be one of 'xs' | 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|emphasized|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label, icon, emphasized."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextArea'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|defaultValue|placeholder|helper|error|maxLength|showCount|rows|disabled|onChange|id|style|key|ref|className|style|children)$/]",
        "message": "<TextArea> doesn't accept that prop. Declared props: label, value, defaultValue, placeholder, helper, error, maxLength, showCount, rows, disabled, onChange, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|eventType|date|title|subtitle|thumbnail|playable|first|last|onClick|style|key|ref|className|style|children)$/]",
        "message": "<TimelineRow> doesn't accept that prop. Declared props: icon, eventType, date, title, subtitle, thumbnail, playable, first, last, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineRow'] > JSXAttribute[name.name='eventType'] > Literal[value!=/^(?:workout|honor|goal|chapter-open|chapter-seal|program|accomplishment|photo|rank|memory)$/]",
        "message": "<TimelineRow> eventType must be one of 'workout' | 'honor' | 'goal' | 'chapter-open' | 'chapter-seal' | 'program' | 'accomplishment' | 'photo' | 'rank' | 'memory'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|message|icon|duration|onDismiss|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: open, message, icon, duration, onDismiss, style."
      }
    ]
  },
