.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# design-sync (generated output — committed: .design-sync/config.json, NOTES.md, conventions.md)
ds-bundle/
.ds-sync/
.design-sync/.cache/
.design-sync/learnings/
