# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# design-sync (generated output — committed: .design-sync/config.json, NOTES.md, conventions.md)
ds-bundle/
.ds-sync/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# supabase — local secrets (publishable key is client-safe but env-managed; service_role NEVER committed)
.env
supabase/.temp/
supabase/.branches/

# generated ingest output — reference artifacts, not source (regenerated by the ingest pipeline)
src/domain/training/ingest/out/

# scratch / temp / audit artifacts — never source
/Scratch/
/_repo-audit/
index_extract_tmp.txt
legacy-design-test.zip

# design_reference: track the SOURCE (.dc.html / .js / .css / small dirs); NOT the heavy media.
# uploads/ (140MB transient slot media) + assets/ (98MB renders) + screenshots/ bloat git permanently
# and aren't the north star. Un-ignore a line below if a fresh clone needs the rendered reference.
design_reference/**/uploads/
design_reference/**/assets/
design_reference/**/screenshots/
design_reference/**/.thumbnail
design_reference/**/.image-slots.state.json

# The design tool's own 4MB standalone export — reference only, never the deployed artifact.
# See site/README.md 'Why not just deploy the design tool's own export'.
site/_exported-bundle.html
