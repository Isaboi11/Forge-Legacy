{
  "cli": {
    "version": ">= 21.5.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "SENTRY_ALLOW_FAILURE": "true" },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "SENTRY_ALLOW_FAILURE": "true" },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "env": { "SENTRY_ALLOW_FAILURE": "true" },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6798436104",
        "appleTeamId": "G722GV8H8C"
      }
    }
  }
}
