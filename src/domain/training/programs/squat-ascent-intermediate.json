{
 "id": "squat-ascent-intermediate",
 "name": "Squat Ascent Intermediate",
 "family": "Strength",
 "difficulty": "Intermediate",
 "durationWeeks": 4,
 "frequencyPerWeek": 5,
 "environment": "Commercial Gym",
 "description": "Four weeks built around one lift. You squat five days a week, every session loaded from a single max you test at the start and do not touch again until the last day. Most of the work sits at moderate weight; the bar only gets genuinely heavy four times. Volume peaks in week two and falls away into a rehearsal, two short speed sessions and a test.",
 "goals": [
  "Add weight to a tested back squat",
  "Build tolerance to squatting at high frequency",
  "Practise handling a near-maximal bar before testing one",
  "Hold upper-body and posterior strength through a lower-body block"
 ],
