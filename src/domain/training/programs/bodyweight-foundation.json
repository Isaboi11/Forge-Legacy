  "id": "bodyweight-foundation",
  "name": "Bodyweight Foundation",
  "family": "Full Body & Home",
  "difficulty": "Beginner",
  "durationWeeks": 6,
  "frequencyPerWeek": 3,
  "environment": "Anywhere — no equipment required",
  "description": "Six weeks, three days a week, no equipment and nowhere you have to be. Each session trains the whole body through the five patterns a person actually needs — squat, push, pull, hinge and brace — and progresses the way bodyweight training has to: more reps first, then a harder version of the same movement. A knee push-up becomes a push-up becomes a close-grip push-up. Nothing is added to the bar because there is no bar.",
  "goals": ["Build a general-fitness base with no equipment and no gym", "Learn to squat, push, pull, hinge and brace with competent form", "Earn a harder variation rather than rushing it", "Hold three sessions a week for six weeks", "Arrive ready for Bodyweight Strength"],
  "successorName": "Bodyweight Strength",
  "theme": "beginner",
  "structure": "full_body",
  "status": "AUTHORED — Stage 2 complete, PO Lock Approval outstanding",
  "source": "forge",
