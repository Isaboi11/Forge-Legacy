{
 "id": "bench-approach-intermediate",
 "name": "Bench Approach Intermediate",
 "family": "Strength",
 "difficulty": "Intermediate",
 "durationWeeks": 4,
 "frequencyPerWeek": 5,
 "environment": "Commercial Gym",
 "description": "Four weeks built around one lift. You bench five days a week, every session loaded from a single max you test at the start and do not touch again until the last day. Most of the work sits at moderate weight; the bar only gets genuinely heavy four times. Volume peaks in week two and falls away into a rehearsal, two short sessions and a test.",
 "goals": [
  "Add weight to a tested bench press",
  "Build tolerance to pressing at high frequency",
  "Practise handling a near-maximal bar before testing one",
  "Hold lower-body and pulling strength through an upper-body block"
 ],
