{
  "id": "strength-builder-i-4day",
  "name": "Strength Builder I (4-Day)",
  "family": "Strength",
  "difficulty": "Advanced",
  "durationWeeks": 10,
  "frequencyPerWeek": 4,
  "environment": "Commercial Gym",
  "description": "Ten weeks on the four lifts, four days a week, for somebody who is past being taught them. Each day opens with one barbell lift carried from a top set into back-offs, and every week moves that top set — eights, then fives, then triples — before a deload pays for the block. The accessory work exists to keep the main lift moving: pulling for the bench, position work for the squat, and a face pull at the end of every pressing week.",
  "goals": [
    "Add weight to the squat, bench, deadlift and overhead press across ten weeks",
    "Train each of the four lifts once a week at a real top set",
    "Learn to work from a top set into back-offs rather than grinding every set",
    "Hold a four-day week for ten weeks, deloads included",
    "Finish the block ready to test, or to run a specialisation on one lift"
  ],
  "successorName": "Squat Ascent Intermediate",
  "theme": "strength",
  "status": "AUTHORED — original program, PO Lock Approval outstanding",
  "source": "forge",
