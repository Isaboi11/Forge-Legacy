{
  "id": "frame-by-frame-5day",
  "name": "Frame by Frame (5-Day)",
  "family": "Muscle Building",
  "difficulty": "Intermediate",
  "durationWeeks": 10,
  "frequencyPerWeek": 5,
  "environment": "Commercial Gym",
  "description": "Ten weeks, five days, one body part at a time — back, chest, legs, shoulders, arms. Each day gets a heavy compound to open it and then everything else that muscle can absorb, which is the trade a body-part split makes: you train each part once a week, so you train it properly when you get there. Sets and reps climb for eight weeks. Week 9 backs off. Week 10 is the most work in the block.",
  "goals": ["Add size to every major muscle group over ten weeks", "Train one body part per session, hard enough to justify the week between", "Hold a five-day week without the sessions bleeding into each other", "Progress by adding reps and sets, not by guessing at weight", "Finish the block having done more in week 10 than in week 1"],
  "successorName": null,
  "theme": "bodybuilding",
  "status": "AUTHORED — original program, PO Lock Approval outstanding",
  "source": "forge",
  "sourceFile": "Programs/Hypertrophy/Frame by Frame/Design-Record.md",
