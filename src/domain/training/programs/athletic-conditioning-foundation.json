{
  "id": "athletic-conditioning-foundation",
  "name": "Athletic Conditioning Foundation",
  "family": "Conditioning",
  "difficulty": "Beginner",
  "durationWeeks": 8,
  "frequencyPerWeek": 3,
  "environment": "Commercial Gym",
  "description": "Eight weeks, three days a week, for someone who wants to be fitter and has never trained conditioning on purpose. Every session opens on a steady bout, carries its work in a short circuit you repeat, and finishes with two simple lifts — the conditioning is the point and the weights are there to support it. Rounds and minutes climb for six weeks. Week 7 backs off. Week 8 is the most work in the block.",
  "goals": ["Build a base of work capacity from a standing start", "Learn how a circuit and a work-to-rest structure actually feel", "Get well-rounded fitness without chasing a number", "Hold three sessions a week for eight weeks", "Arrive ready for Conditioning Intermediate"],
  "successorName": "Conditioning Intermediate",
  "theme": "athletic_performance",
  "status": "AUTHORED — Stage 2 complete, PO Lock Approval outstanding",
  "source": "forge",
  "sourceFile": "Programs/Conditioning/Athletic Conditioning Foundation/Design-Record.md",
