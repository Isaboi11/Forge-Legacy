{
 "id": "deadlift-measure-intermediate",
 "name": "Deadlift Measure Intermediate",
 "family": "Strength",
 "difficulty": "Intermediate",
 "durationWeeks": 4,
 "frequencyPerWeek": 4,
 "environment": "Commercial Gym",
 "description": "Four weeks built around one lift, pulled from the floor twice a week and never on back-to-back days. Every deadlift is loaded from a single max you test at the start and do not touch again until the last day. The other two sessions carry pull variations and squat work, which build the same positions for a fraction of the spinal cost. Volume peaks in week two, the bar keeps climbing to a rehearsal at 93%, then a short taper into a test.",
 "goals": [
  "Add weight to a tested deadlift",
  "Build the pull without pulling heavy every session",
  "Practise handling a near-maximal pull before testing one",
  "Hold squat and upper-body strength through a pulling block"
 ],
