{
  "id": "muscle-building-intermediate",
  "name": "Muscle Building Intermediate",
  "family": "Muscle Building",
  "difficulty": "Intermediate",
  "durationWeeks": 10,
  "frequencyPerWeek": 4,
  "environment": "Commercial Gym",
  "description": "Ten weeks of upper and lower, twice each per week, with every major muscle group trained inside a balanced weekly dose — no region carried at another's expense. Every exercise is prescribed as a rep range: hit the top of it on all sets and the load goes up. Sets climb from week 1 to week 8, week 9 backs off, and week 10 is the most work in the block. It is the middle rung of the Muscle Building ladder and the on-ramp to a periodized program.",
  "goals": ["Add muscle across the whole physique, not one favoured region", "Run a rep range properly — add load when you reach the top of it on every set", "Absorb a rising weekly set count across eight weeks and recover from it", "Train each muscle group twice a week for ten weeks", "Arrive ready for the block periodization of Muscle Building Advanced"],
  "successorName": "Muscle Building Advanced",
  "theme": "hypertrophy",
  "structure": "upper_lower",
  "status": "AUTHORED — Stage 2 complete, PO Lock Approval outstanding",
  "source": "forge",
