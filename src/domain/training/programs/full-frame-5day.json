{
  "id": "full-frame-5day",
  "name": "Full Frame (5-Day)",
  "family": "Muscle Building",
  "difficulty": "Intermediate",
  "durationWeeks": 6,
  "frequencyPerWeek": 5,
  "environment": "Commercial Gym",
  "description": "Five days a week, every muscle group trained twice. Push, Pull and Legs open the week, then Upper and Lower hit it all again — the two five-day templates people usually argue about, run together. The big lifts never change, so you can actually chase a number on them: bench, squat, deadlift and sumo are the same movements in week 6 as in week 1, only heavier. Everything around them moves. Reps start high and come down as the loads climb, and the isolation work swaps to new angles for the final block, so the last fortnight is not a photocopy of the first.",
  "goals": [
    "Add muscle across the whole body",
    "Train every muscle group twice a week",
    "Add weight to the bench, squat and deadlift over six weeks",
    "Hold a five-day week without missing sessions"
  ],
