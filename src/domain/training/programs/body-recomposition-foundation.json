{
  "id": "body-recomposition-foundation",
  "name": "Body Recomposition Foundation",
  "family": "Conditioning",
  "difficulty": "Beginner",
  "durationWeeks": 8,
  "frequencyPerWeek": 4,
  "environment": "Commercial Gym",
  "description": "Eight weeks, four days a week, for the athlete who wants to lose fat without losing the muscle underneath it. Every session opens with resistance work — the part that tells your body to keep what it already has — and closes with steady, unhurried conditioning that spends calories without spending the next session. The movements are machines, dumbbells and your own bodyweight: learnable on the first day and still loadable in the eighth week. Week 7 backs off on purpose. Week 8 is the most work in the block.",
  "goals": [
    "Lose fat while keeping the muscle you already carry",
    "Learn to press, pull, squat and hinge on equipment that teaches rather than tests",
    "Hold four training days a week for eight weeks",
    "Finish steady conditioning without it costing you the next session",
    "Arrive ready for Body Recomposition Intermediate"
  ],
  "successorName": "Body Recomposition Intermediate",
  "theme": "cutting",
  "structure": "upper_lower",
  "status": "AUTHORED — Stage 2 complete, PO Lock Approval outstanding",
