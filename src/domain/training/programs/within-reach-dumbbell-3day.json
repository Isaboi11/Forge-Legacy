{
  "id": "within-reach-dumbbell-3day",
  "name": "Within Reach (3-Day)",
  "family": "Full Body & Home",
  "difficulty": "Intermediate",
  "durationWeeks": 8,
  "frequencyPerWeek": 3,
  "environment": "Home — two adjustable dumbbells and a bench",
  "description": "Eight weeks of real strength work with nothing but a pair of dumbbells. Three full-body days a week, built around the five patterns that matter — squat, hinge, push, pull and carry — and around the one problem dumbbell training actually has: the weight runs out. So the load moves onto one leg and one arm at a time as you get stronger, which is how a fixed pair of bells keeps being enough long after they stop feeling heavy with two hands.",
  "goals": [
    "Build genuine strength without a barbell or a rack",
    "Learn to squat, hinge, press, row and carry under load",
    "Keep progressing after the dumbbells stop feeling heavy, by moving to one limb at a time",
    "Hold three sessions a week for eight weeks",
    "Arrive ready for a barbell program, or for Close Quarters if you would rather add size"
  ],
  "successorName": null,
  "theme": "strength",
  "structure": "full_body",
  "status": "AUTHORED — original program, PO Lock Approval outstanding",
  "source": "forge",
